[Unit]
Description=AI Desktop isolated subscription analysis for UID %i
Requires=ai-desktop-analysis@%i.socket
After=ai-desktop-analysis@%i.socket
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
Type=exec
User=ai-desktop
Group=ai-desktop
ExecStart=/usr/bin/python3 -I -B /usr/lib/ai-desktop/analysis-worker.py %i
WorkingDirectory=/
Environment=HOME=/var/lib/ai-desktop LANG=C.UTF-8
UnsetEnvironment=PYTHONPATH PYTHONHOME LD_PRELOAD LD_LIBRARY_PATH
StandardInput=null
StandardOutput=null
StandardError=null
UMask=0077
Restart=no
# One terminal session may last a whole conversation (HOLD_SECONDS) plus a minute; the worker leaves sooner when idle,
# and before this limit on its own without cutting off an answer (analysis_service.WORKER_SECONDS must match).
RuntimeMaxSec=15480
TimeoutStopSec=3
KillMode=control-group
# Up to four requests at once (PARALLEL_REQUESTS), each with up to 768 MiB sealed client + 768 MiB child tmpfs
# and 1.5 GiB native headroom: a ceiling, not a reservation. One thread per connection (MAX_CONNECTIONS = 64) on top.
TasksMax=448
MemoryMax=12G
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ai-desktop
# The trusted supervisor may read the fixed AUR native client in /opt.
# The model's separate mount namespace receives only verified client snapshots.
InaccessiblePaths=-/mnt -/media -/srv
# Do not overmount pieces of the supervisor's /proc: Linux then refuses a
# fresh procfs in bwrap's unprivileged PID namespace. The child remounts its
# own entire /proc read-only after creating it and verifies that mount flag.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectKernelLogs=no
ReadOnlyPaths=/sys
ProtectControlGroups=yes
RestrictNamespaces=user mnt pid net ipc uts
RestrictRealtime=yes
# This setting blocks openat2, required by modern Bubblewrap builds. The
# trusted child installs the mode-bit/openat2 filter AFTER namespace setup,
# before any native executable or bridge thread. NNP/caps restrictions apply
# throughout; only the trusted Python/setup supervisor lacks the mode filter.
RestrictSUIDSGID=no
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
# The trusted Python proxy has uplink; every native client must pass bwrap's
# fresh net/PID/mount/user namespaces and effective confinement checks.
# Bun/JIT needs executable mappings. Do not copy the offline worker's MDWE or
# socket-denying seccomp profile here: bwrap also needs mount/unshare syscalls.
